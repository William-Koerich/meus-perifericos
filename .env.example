# Copie para .env.local e preencha. Nunca commite o .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (somente servidor) — usada pelo admin para criar/desativar usuários
SUPABASE_SECRET_KEY=sb_secret_xxx

# Supabase → Connect → ORMs / Connection string
# App: pooler em modo TRANSACTION (porta 6543), usado com prepare: false
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations (drizzle-kit): pooler em modo SESSION (porta 5432)
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require

# Nome do bucket de fotos no Supabase Storage
NEXT_PUBLIC_SUPABASE_BUCKET_FOTOS=periferico-fotos
